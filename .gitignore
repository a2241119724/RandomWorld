# Public source snapshot.
# By default, everything is included.
# We explicitly ignore private folders and file types below.

# Ensure ALL .meta files are tracked (place early to be safe)
!**/*.meta

# Repository metadata and public docs.
# These were already allowed; still fine.
/.gitignore
/README.md

# Game source code (already public in your plan).
/Scripts/
/Scripts/**/
/Scripts/**/*.cs
/Scripts/**/*.md

# Optional top-level editor scripts.
/Editor/
/Editor/**/
/Editor/**/*.cs

# Keep vendor/package code private.
/Scripts/Reference/

# Do not publish runnable Unity content.
/AddressableAssetsData/
/Animation/
/Build/
/Materials/
/Resources/
/ResourcesLocal/
/Scenes/
/StreamingAssets/
/TextMesh Pro/
/URP/

# Local assistants, automation output, memory, reports, and caches.
/.claude/
**/__pycache__/
**/cache/
**/reports/
**/Reports/

# Unity, IDE, and generated files.
/.vs/
/Library/
/Logs/
/Temp/
/Obj/
/obj/
/MemoryCaptures/
/UserSettings/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build outputs and logs.
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.log
hs_err_pid*.log

# Asset file types that should stay private.
*.asset
*.prefab
*.unity
*.mat
*.lighting
*.controller
*.anim
*.spriteatlas
*.renderTexture
*.colors
*.png
*.jpg
*.jpeg
*.gif
*.psd
*.tga
*.fbx
*.mp3
*.wav
*.ogg
*.ttf
*.otf