# Public source snapshot.
# By default, everything is included.
# We explicitly ignore private folders and file types below.

# Ensure ALL .meta files are tracked where needed.
!**/*.meta

# Ensure ALL .cs files are tracked (except in explicitly private dirs).
!**/*.cs

# Repository metadata and public docs.
!/.gitignore
!/README.md

# Game source code – fully public.
!/Scripts
!/Scripts/**/
!/Scripts/**/*.cs
!/Scripts/**/*.md

# Optional top-level editor scripts – fully public.
!/Editor
!/Editor/**/
!/Editor/**/*.cs

# Keep vendor/package code completely private (no .cs, no .meta).
/Scripts/Reference/

# Do not publish runnable Unity content, but keep .meta and .cs files.
/AddressableAssetsData/**
!/AddressableAssetsData/**/*.meta
!/AddressableAssetsData/**/*.cs

/Animation/**
!/Animation/**/*.meta
!/Animation/**/*.cs

/Build/**
!/Build/**/*.meta
!/Build/**/*.cs

/Materials/**
!/Materials/**/*.meta
!/Materials/**/*.cs

/Resources/**
!/Resources/**/*.meta
!/Resources/**/*.cs

/ResourcesLocal/**
!/ResourcesLocal/**/*.meta
!/ResourcesLocal/**/*.cs

/Scenes/**
!/Scenes/**/*.meta
!/Scenes/**/*.cs

/StreamingAssets/**
!/StreamingAssets/**/*.meta
!/StreamingAssets/**/*.cs

/TextMesh Pro/**
!/TextMesh Pro/**/*.meta
!/TextMesh Pro/**/*.cs

/URP/**
!/URP/**/*.meta
!/URP/**/*.cs

# Local assistants, automation output, memory, reports, and caches.
/.claude/
**/__pycache__/
**/cache/
**/reports/
**/Reports/

# Unity, IDE, and generated files (keep fully ignored).
/.vs/
/Library/
/Logs/
/Temp/
/Obj/
/obj/
/MemoryCaptures/
/UserSettings/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build outputs and logs.
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.log
hs_err_pid*.log

# Asset file types that should stay private.
*.asset
*.prefab
*.unity
*.mat
*.lighting
*.controller
*.anim
*.spriteatlas
*.renderTexture
*.colors
*.png
*.jpg
*.jpeg
*.gif
*.psd
*.tga
*.fbx
*.mp3
*.wav
*.ogg
*.ttf
*.otf